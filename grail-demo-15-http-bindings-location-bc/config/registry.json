{
  "startCustomerOnboarding": {
    "id": "aff-c1",
    "action": "startCustomerOnboarding",
    "type": "task",
    "preconditions": [],
    "inputs": {},
    "effects": [
      "onboardingStarted"
    ]
  },
  "collectCustomerProfile": {
    "id": "aff-c2",
    "action": "collectCustomerProfile",
    "type": "task",
    "preconditions": [
      "onboardingStarted"
    ],
    "inputs": {
      "givenName": "$inputs.givenName",
      "familyName": "$inputs.familyName"
    },
    "effects": [
      "customerProfileCollected"
    ]
  },
  "setCustomerEmail": {
    "id": "aff-c3",
    "action": "setCustomerEmail",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "email": "$inputs.email"
    },
    "effects": [
      "customerEmailSet"
    ]
  },
  "verifyCustomerEmail": {
    "id": "aff-c4",
    "action": "verifyCustomerEmail",
    "type": "task",
    "preconditions": [
      "customerEmailSet"
    ],
    "inputs": {
      "emailVerificationCode": "$inputs.emailVerificationCode"
    },
    "effects": [
      "customerEmailVerified"
    ]
  },
  "setCustomerPhoneNumber": {
    "id": "aff-c5",
    "action": "setCustomerPhoneNumber",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "phoneNumber": "$inputs.phoneNumber"
    },
    "effects": [
      "customerPhoneNumberSet"
    ]
  },
  "verifyCustomerPhoneNumber": {
    "id": "aff-c6",
    "action": "verifyCustomerPhoneNumber",
    "type": "task",
    "preconditions": [
      "customerPhoneNumberSet"
    ],
    "inputs": {
      "phoneVerificationCode": "$inputs.phoneVerificationCode"
    },
    "effects": [
      "customerPhoneNumberVerified"
    ]
  },
  "setCustomerAddress": {
    "id": "aff-c7",
    "action": "setCustomerAddress",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "streetAddress": "$inputs.streetAddress",
      "locality": "$inputs.locality",
      "region": "$inputs.region",
      "postalCode": "$inputs.postalCode",
      "country": "$inputs.country"
    },
    "effects": [
      "customerAddressSet"
    ]
  },
  "acceptCustomerTerms": {
    "id": "aff-c8",
    "action": "acceptCustomerTerms",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "termsVersion": "$inputs.termsVersion"
    },
    "effects": [
      "customerTermsAccepted"
    ]
  },
  "onboardCustomer": {
    "id": "aff-c9",
    "action": "onboardCustomer",
    "type": "task",
    "preconditions": [
      "onboardingStarted",
      "customerProfileCollected",
      "customerEmailSet",
      "customerEmailVerified",
      "customerPhoneNumberSet",
      "customerPhoneNumberVerified",
      "customerAddressSet",
      "customerTermsAccepted",
      "httpBindingTested"
    ],
    "inputs": {},
    "effects": [
      "customerOnboarded"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/execute"
    }
  },
  "loadCustomer": {
    "id": "aff-c10",
    "action": "loadCustomer",
    "type": "task",
    "preconditions": [],
    "inputs": {
      "customerId": "$inputs.customerId"
    },
    "effects": [
      "customerLoaded"
    ]
  },
  "writeCustomerAddressChange": {
    "id": "aff-c11",
    "action": "writeCustomerAddressChange",
    "type": "task",
    "preconditions": [
      "customerLoaded"
    ],
    "inputs": {
      "newStreetAddress": "$inputs.newStreetAddress",
      "newLocality": "$inputs.newLocality",
      "newRegion": "$inputs.newRegion",
      "newPostalCode": "$inputs.newPostalCode",
      "newCountry": "$inputs.newCountry"
    },
    "effects": [
      "customerAddressChangePrepared"
    ]
  },
  "changeCustomerAddress": {
    "id": "aff-c12",
    "action": "changeCustomerAddress",
    "type": "task",
    "preconditions": [
      "customerLoaded",
      "customerAddressChangePrepared"
    ],
    "inputs": {},
    "effects": [
      "customerAddressChanged"
    ]
  },
  "prepareCustomerEmailChange": {
    "id": "aff-c13",
    "action": "prepareCustomerEmailChange",
    "type": "task",
    "preconditions": [
      "customerLoaded"
    ],
    "inputs": {
      "newEmail": "$inputs.newEmail"
    },
    "effects": [
      "customerEmailChangePrepared"
    ]
  },
  "changeCustomerEmail": {
    "id": "aff-c14",
    "action": "changeCustomerEmail",
    "type": "task",
    "preconditions": [
      "customerEmailChangePrepared"
    ],
    "inputs": {
      "emailVerificationCode": "$inputs.emailVerificationCode"
    },
    "effects": [
      "customerEmailChanged"
    ]
  },
  "prepareCustomerPhoneNumberChange": {
    "id": "aff-c15",
    "action": "prepareCustomerPhoneNumberChange",
    "type": "task",
    "preconditions": [
      "customerLoaded"
    ],
    "inputs": {
      "newPhoneNumber": "$inputs.newPhoneNumber"
    },
    "effects": [
      "customerPhoneChangePrepared"
    ]
  },
  "changeCustomerPhoneNumber": {
    "id": "aff-c16",
    "action": "changeCustomerPhoneNumber",
    "type": "task",
    "preconditions": [
      "customerPhoneChangePrepared"
    ],
    "inputs": {
      "phoneVerificationCode": "$inputs.phoneVerificationCode"
    },
    "effects": [
      "customerPhoneNumberChanged"
    ]
  },
  "setCustomerContactDetails": {
    "id": "aff-c17",
    "action": "setCustomerContactDetails",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "email": "$inputs.email",
      "phoneNumber": "$inputs.phoneNumber",
      "streetAddress": "$inputs.streetAddress",
      "locality": "$inputs.locality",
      "region": "$inputs.region",
      "postalCode": "$inputs.postalCode",
      "country": "$inputs.country"
    },
    "effects": [
      "customerEmailSet",
      "customerPhoneNumberSet",
      "customerAddressSet"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/execute",
      "contentType": "application/x-www-form-urlencoded"
    }
  },
  "testHttpBinding": {
    "id": "aff-http-test",
    "action": "testHttpBinding",
    "type": "task",
    "preconditions": [],
    "inputs": {
      "customerId": "$inputs.customerId",
      "region": "$inputs.region",
      "termsVersion": "$inputs.termsVersion",
      "email": "$inputs.email"
    },
    "effects": [
      "httpBindingTested"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/binding-test/{customerId}",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "region": {
          "in": "query",
          "name": "lang"
        },
        "termsVersion": {
          "in": "header",
          "name": "X-Test-Token"
        },
        "email": {
          "in": "body",
          "name": "emailAddress"
        }
      }
    }
  }
}
