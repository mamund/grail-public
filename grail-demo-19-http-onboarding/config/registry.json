{
  "onboardCustomer": {
    "id": "aff-onboard-customer",
    "action": "onboardCustomer",
    "type": "task",
    "preconditions": [
      "customerProfileCollected",
      "customerEmailVerified",
      "customerPhoneNumberVerified",
      "customerAddressSet",
      "customerTermsAccepted"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId"
    },
    "effects": [
      "customerOnboarded"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/customers/{customerId}/onboarding",
      "parameters": {
        "customerId": {
          "in": "path"
        }
      },
      "outputs": {
        "accountId": {
          "from": "body",
          "path": "accountId"
        }
      }
    }
  },
  "verifyCustomerEmail": {
    "id": "aff-verify-customer-email",
    "action": "verifyCustomerEmail",
    "type": "task",
    "preconditions": [
      "customerEmailSet"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId",
      "emailVerificationId": "$outputs.latest.emailVerificationId"
    },
    "effects": [
      "customerEmailVerified"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/customers/{customerId}/email/verification",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "emailVerificationId": {
          "in": "body"
        }
      },
      "outputs": {
        "verifiedEmail": {
          "from": "body",
          "path": "verifiedEmail"
        }
      }
    }
  },
  "setCustomerEmail": {
    "id": "aff-set-customer-email",
    "action": "setCustomerEmail",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId",
      "email": "$inputs.email"
    },
    "effects": [
      "customerEmailSet"
    ],
    "binding": {
      "protocol": "http",
      "method": "PUT",
      "url": "http://localhost:3001/customers/{customerId}/email",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "email": {
          "in": "body"
        }
      },
      "outputs": {
        "emailVerificationId": {
          "from": "body",
          "path": "emailVerificationId"
        }
      }
    }
  },
  "createCustomerProfile": {
    "id": "aff-create-customer-profile",
    "action": "createCustomerProfile",
    "type": "task",
    "preconditions": [
      "onboardingStarted"
    ],
    "inputs": {
      "onboardingId": "$outputs.startOnboarding.latest.onboardingId",
      "name": "$inputs.name"
    },
    "effects": [
      "customerProfileCollected"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/customers",
      "parameters": {
        "onboardingId": {
          "in": "body"
        },
        "name": {
          "in": "body"
        }
      },
      "outputs": {
        "customerId": {
          "from": "body",
          "path": "customerId"
        }
      }
    }
  },
  "setCustomerDetails": {
    "enabled": true,
    "id": "aff-set-customer-details",
    "action": "setCustomerDetails",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId",
      "email": "$inputs.email",
      "phone": "$inputs.phone",
      "street": "$inputs.street",
      "city": "$inputs.city",
      "state": "$inputs.state",
      "postalCode": "$inputs.postalCode"
    },
    "effects": [
      "customerEmailSet",
      "customerPhoneNumberSet",
      "customerAddressSet"
    ],
    "binding": {
      "protocol": "http",
      "method": "PUT",
      "url": "http://localhost:3001/customers/{customerId}/details",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "email": {
          "in": "body"
        },
        "phone": {
          "in": "body"
        },
        "street": {
          "in": "body"
        },
        "city": {
          "in": "body"
        },
        "state": {
          "in": "body"
        },
        "postalCode": {
          "in": "body"
        }
      },
      "outputs": {
        "emailVerificationId": {
          "from": "body",
          "path": "emailVerificationId"
        },
        "phoneVerificationId": {
          "from": "body",
          "path": "phoneVerificationId"
        }
      }
    }
  },
  "startOnboarding": {
    "id": "aff-start-onboarding",
    "action": "startOnboarding",
    "type": "task",
    "preconditions": [],
    "inputs": {},
    "effects": [
      "onboardingStarted"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/onboarding",
      "parameters": {},
      "outputs": {
        "onboardingId": {
          "from": "body",
          "path": "onboardingId"
        }
      }
    }
  },
  "acceptTerms": {
    "id": "aff-accept-terms",
    "action": "acceptTerms",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId",
      "termsVersion": "$inputs.termsVersion"
    },
    "effects": [
      "customerTermsAccepted"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/customers/{customerId}/terms",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "termsVersion": {
          "in": "body"
        }
      }
    }
  },
  "setCustomerAddress": {
    "id": "aff-set-customer-address",
    "action": "setCustomerAddress",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId",
      "street": "$inputs.street",
      "city": "$inputs.city",
      "state": "$inputs.state",
      "postalCode": "$inputs.postalCode"
    },
    "effects": [
      "customerAddressSet"
    ],
    "binding": {
      "protocol": "http",
      "method": "PUT",
      "url": "http://localhost:3001/customers/{customerId}/address",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "street": {
          "in": "body"
        },
        "city": {
          "in": "body"
        },
        "state": {
          "in": "body"
        },
        "postalCode": {
          "in": "body"
        }
      }
    }
  },
  "verifyCustomerPhone": {
    "id": "aff-verify-customer-phone",
    "action": "verifyCustomerPhone",
    "type": "task",
    "preconditions": [
      "customerPhoneNumberSet"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId",
      "phoneVerificationId": "$outputs.latest.phoneVerificationId"
    },
    "effects": [
      "customerPhoneNumberVerified"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/customers/{customerId}/phone/verification",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "phoneVerificationId": {
          "in": "body"
        }
      },
      "outputs": {
        "verifiedPhone": {
          "from": "body",
          "path": "verifiedPhone"
        }
      }
    }
  },
  "setCustomerPhone": {
    "id": "aff-set-customer-phone",
    "action": "setCustomerPhone",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "customerId": "$outputs.createCustomerProfile.latest.customerId",
      "phone": "$inputs.phone"
    },
    "effects": [
      "customerPhoneNumberSet"
    ],
    "binding": {
      "protocol": "http",
      "method": "PUT",
      "url": "http://localhost:3001/customers/{customerId}/phone",
      "parameters": {
        "customerId": {
          "in": "path"
        },
        "phone": {
          "in": "body"
        }
      },
      "outputs": {
        "phoneVerificationId": {
          "from": "body",
          "path": "phoneVerificationId"
        }
      }
    }
  }
}
