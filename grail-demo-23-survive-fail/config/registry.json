{
  "onboardCustomerNode": {
    "id": "aff-onboard-customer-node",
    "action": "onboardCustomerNode",
    "type": "task",
    "preconditions": [
      "customerProfileCollected",
      "customerEmailVerified",
      "customerPhoneNumberVerified",
      "customerAddressSet",
      "customerTermsAccepted"
    ],
    "inputs": {
      "customerId": "$outputs.latest.customerId"
    },
    "effects": [
      "customerOnboarded"
    ],
    "binding": {
      "protocol": "node",
      "module": "../customer-onboarding/capabilities/onboarding.js",
      "function": "onboardCustomer",
      "outputs": {
        "accountId": {
          "from": "result",
          "path": "accountId"
        }
      }
    }
  },
  "onboardCustomerHttp": {
    "id": "aff-onboard-customer-http",
    "action": "onboardCustomerHttp",
    "type": "task",
    "preconditions": [
      "customerProfileCollected",
      "customerEmailVerified",
      "customerPhoneNumberVerified",
      "customerAddressSet",
      "customerTermsAccepted"
    ],
    "inputs": {
      "customerId": "$outputs.latest.customerId"
    },
    "effects": [
      "customerOnboarded"
    ],
    "binding": {
      "protocol": "http",
      "method": "POST",
      "url": "http://localhost:3001/customers/{customerId}/onboarding",
      "parameters": {
        "customerId": {
          "in": "path"
        }
      },
      "outputs": {
        "accountId": {
          "from": "body",
          "path": "accountId"
        }
      }
    }
  },  
