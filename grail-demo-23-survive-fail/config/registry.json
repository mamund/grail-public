        },
        "phoneVerificationId": {
          "from": "result",
          "path": "phoneVerificationId"
        }
      }
    }
  },
  "setCustomerDetailsHttp": {
    "enabled": true,
    "id": "aff-set-customer-details-http",
    "action": "setCustomerDetailsHttp",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "customerId": "$outputs.latest.customerId",
