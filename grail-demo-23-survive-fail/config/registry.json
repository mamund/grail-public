  "setCustomerDetailsNode": {
    "enabled": true,
    "id": "aff-set-customer-details-node",
    "action": "setCustomerDetailsNode",
    "type": "task",
    "preconditions": [
      "customerProfileCollected"
    ],
    "inputs": {
      "customerId": "$outputs.latest.customerId",
      "email": "$inputs.email",
      "phone": "$inputs.phone",
      "street": "$inputs.street",
      "city": "$inputs.city",
      "state": "$inputs.state",
      "postalCode": "$inputs.postalCode"
    },
    "effects": [
      "customerEmailSet",
      "customerPhoneNumberSet",
      "customerAddressSet"
    ],
    "binding": {
      "protocol": "node",
      "module": "../customer-onboarding/capabilities/customer.js",
