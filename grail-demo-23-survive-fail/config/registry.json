        "customerId": {
          "in": "path"
        },
        "email": {
          "in": "body"
        },
        "phone": {
          "in": "body"
        },
        "street": {
          "in": "body"
        },
        "city": {
          "in": "body"
        },
        "state": {
          "in": "body"
        },
        "postalCode": {
          "in": "body"
